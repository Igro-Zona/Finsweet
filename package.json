{
	"name": "fitsweet",
	"type": "module",
	"version": "1.0.0",
	"browserslist": [
		">0.5%",
		"last 8 versions",
		"not dead"
	],
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && npm run postcss",
		"preview": "astro preview",
		"astro": "astro",
		"postcss": "npx postcss dist/**/*.css --config postcss.config.mjs --replace",
		"st": "stylelint \"**/*.{css,scss,astro}\"",
		"st:fix": "stylelint \"**/*.{css,scss,astro}\" --fix",
		"pr": "prettier --check .",
		"pr:fix": "prettier --write ."
	},
	"dependencies": {
		"@tailwindcss/vite": "4.1.13",
		"tailwindcss": "4.1.13",
		"react": "19.1.1",
		"react-dom": "19.1.1"
	},
	"devDependencies": {
		"@astrojs/react": "4.3.0",
		"@astrojs/sitemap": "3.5.1",
		"@types/react": "19.1.12",
		"@types/react-dom": "19.1.9",
		"astro": "5.13.5",
		"globals": "16.4.0",
		"postcss": "8.5.6",
		"postcss-cli": "11.0.1",
		"postcss-html": "1.8.0",
		"postcss-preset-env": "10.3.1",
		"postcss-pxtorem": "6.1.0",
		"postcss-scss": "4.0.9",
		"postcss-sort-media-queries": "5.2.0",
		"prettier": "3.6.2",
		"prettier-plugin-astro": "0.14.1",
		"sass-embedded": "1.92.1",
		"stylelint": "16.23.1",
		"stylelint-order": "7.0.0",
		"stylelint-scss": "6.12.1"
	}
}
